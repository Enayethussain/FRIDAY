# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- FRIDAY backend v1 (server-side only; never ship keys in the APK) ----
# AI_PROVIDER: gemini (default) | openai-compatible | ollama | disabled
AI_PROVIDER="gemini"
# AI_API_KEY: server-side key for the selected provider (falls back to GEMINI_API_KEY).
AI_API_KEY=""
# AI_MODEL: override model (default: gemini-3.6-flash for gemini).
AI_MODEL=""
# AI_BASE_URL: required only for AI_PROVIDER=openai-compatible.
AI_BASE_URL=""
# AI_OLLAMA_URL: optional PC/local Ollama base URL. Leave empty (disabled) for
# normal phone operation — the phone must NEVER need Ollama.
AI_OLLAMA_URL=""
# AI_FALLBACK_PROVIDER: optional explicitly-configured fallback (e.g. ollama).
AI_FALLBACK_PROVIDER=""
# BACKEND_URL: canonical public backend URL (CORS allowlist + status output).
BACKEND_URL=""
# DATABASE_URL: persistent store file path (default: data/friday-store.json).
DATABASE_URL=""
# Daily AI chat limits per device (server-side quota, free-first defaults).
FREE_DAILY_LIMIT="30"
PRO_DAILY_LIMIT="300"
PLUS_DAILY_LIMIT="1000"
# Max paired devices per effective plan (existing devices are never removed).
MAX_DEVICES_FREE="2"
MAX_DEVICES_PRO="5"
MAX_DEVICES_PLUS="10"
# PLAN_GRANTS: operator plan assignment (server-side only, never the APK).
# Format: "device:<id>:PRO,device:<id2>:PLUS". No user is hard-coded in code.
PLAN_GRANTS=""
# BILLING_PRODUCTS_JSON: override intended DISPLAY price strings only, keyed by
# catalog key (product IDs/plans are fixed in server/billing.ts and must match
# Play Console). Example: {"PRO_MONTHLY":{"price":"₹99/month","currency":"INR"}}.
# Empty = intended launch prices. Missing/invalid config never grants premium.
BILLING_PRODUCTS_JSON=""
# PLAY_SERVICE_ACCOUNT_JSON: Google Play Developer API service-account JSON
# (single-line) for server-side purchase verification. NEVER in the APK.
# Unset = purchases cannot verify (honest 501, nothing granted).
PLAY_SERVICE_ACCOUNT_JSON=""
# MAINTENANCE_MODE=true: v1 chat returns honest 503 maintenance message.
MAINTENANCE_MODE="false"
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (production defaults to WARNING).
LOG_LEVEL=""
# VITE_FRIDAY_SERVER_URL: baked into web/APK builds as the default backend.
# Production APK must point at the deployed HTTPS backend (never localhost).
VITE_FRIDAY_SERVER_URL=""
# VITE_API_BASE_URL: public web frontend (Vercel) backend origin (HTTPS).
# Public config only — NEVER secrets in VITE_* variables.
VITE_API_BASE_URL=""
# VITE_CONTACT_EMAIL / VITE_SUPPORT_URL: public contact details shown on the
# website contact page. Leave empty until real details exist (no fake data).
VITE_CONTACT_EMAIL=""
VITE_SUPPORT_URL=""
# ---- Cashfree web payments (server-side only; NEVER in VITE_* / APK) ----
# Unset = web payments honestly report "not active".
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_WEBHOOK_SECRET=""
# CASHFREE_BASE_URL: default sandbox; production: https://api.cashfree.com/pg
CASHFREE_BASE_URL=""
